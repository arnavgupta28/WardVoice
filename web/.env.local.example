# Required: Next rewrites /api/* requests to the Python backend.
AGENT_BACKEND_URL=http://localhost:8000

# Optional: Supabase Auth for real doctor/family sign-in. Leave unset for the demo localStorage sign-in.
# Use the project's anon (public) key here, never the service role key.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
