# --- Agora (required) — `agora project env write` fills these
AGORA_APP_ID=your_agora_app_id
AGORA_APP_CERTIFICATE=your_agora_app_certificate
# Public URL of this backend's /mcp (Agora cloud calls it). e.g. cloudflared tunnel --url http://localhost:8000
MCP_ENDPOINT=https://<your-tunnel>/mcp
OPENAI_MODEL=gpt-4o-mini

# --- Murf Falcon TTS (required by the hackathon; the agent refuses to start without it)
MURF_API_KEY=your_murf_api_key
MURF_VOICE_ID=en-IN-priya
MURF_LOCALE=en-IN
MURF_MODEL=FALCON
# MURF_BASE_URL=wss://global.api.murf.ai/v1/speech/stream-input
# ALLOW_TTS_FALLBACK=1   # local testing only: use Agora's MiniMax voice when no Murf key

# --- Family email (optional — without a provider, reports are preview-only in the apps)
# RESEND_API_KEY=re_...
# EMAIL_FROM=WardVoice <onboarding@resend.dev>
# or SMTP (e.g. Gmail app password):
# SMTP_HOST=smtp.gmail.com
# SMTP_PORT=587
# SMTP_USER=you@gmail.com
# SMTP_PASSWORD=app-password
# Live demo: send every family email to this inbox instead of the mock addresses
# FAMILY_EMAIL_OVERRIDE=you@example.com
# FAMILY_PORTAL_URL=http://localhost:3000/family

# Pipeline LLM is Agora-managed by default. Set a key for BYO.
# OPENAI_API_KEY=sk-your-openai-key
# OPENAI_BASE_URL=https://api.openai.com/v1/chat/completions
