AGORA_APP_ID=your_agora_app_id
AGORA_APP_CERTIFICATE=your_agora_app_certificate
MCP_ENDPOINT=https://<your-tunnel>/mcp
OPENAI_MODEL=gpt-4o-mini
# Leave AGENT_GREETING unset to use Medi's built-in clinic-concierge greeting.
# AGENT_GREETING=Hi, I'm Medi...

# Murf Falcon TTS (required by the hackathon). Without a key the agent falls back to MiniMax.
MURF_API_KEY=your_murf_api_key
# Voice/locale are configurable; check Murf's voice library for exact IDs.
MURF_VOICE_ID=en-IN-isha
MURF_LOCALE=en-IN
MURF_MODEL=FALCON
# MURF_BASE_URL=wss://global.api.murf.ai/v1/speech/stream-input

# Demo: first booking attempt after a reset returns SLOT_TAKEN so the agent shows recovery. Set 0 to disable.
DEMO_SIMULATE_SLOT_TAKEN=1

# Pipeline is Agora-managed by default. Set a key for BYO; override the URL if needed.
# OPENAI_API_KEY=sk-your-openai-key
# OPENAI_BASE_URL=https://api.openai.com/v1/chat/completions
# Realtime mode uses a separate OpenAI API key.
# OPENAI_REALTIME_API_KEY=sk-your-openai-key
# OPENAI_REALTIME_MODEL=gpt-realtime
